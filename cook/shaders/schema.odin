package shaders

import "core:fmt"
import "core:reflect"
import "core:strings"
import "mirai:asset"

// The include with what shaders know of the material schema of mirai:asset:
// the kinds of maps, the alpha modes and the default values. The engine's
// common.slang includes it, so asset/material.odin is the only place they are
// written.
SCHEMA_INCLUDE :: "material_schema.slang"

// The text of SCHEMA_INCLUDE; it is also part of every fingerprint.
@(private)
material_schema :: proc(allocator:=context.temp_allocator) -> string {
    b:=strings.builder_make(allocator)
    strings.write_string(&b,"// Generated by mirai shaders from mirai:asset. DO NOT EDIT.\n#ifndef MIRAI_MATERIAL_SCHEMA_SLANG\n#define MIRAI_MATERIAL_SCHEMA_SLANG\n")
    strings.write_string(&b,"// asset.Material_Map_Kind: the index of the texture and of the transform of each map.\n")
    for name,i in reflect.enum_field_names(asset.Material_Map_Kind) {fmt.sbprintf(&b,"#define MATERIAL_MAP_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    fmt.sbprintf(&b,"#define MATERIAL_MAPS %d\n",len(asset.Material_Map_Kind))
    strings.write_string(&b,"// asset.Alpha_Mode\n")
    for name,i in reflect.enum_field_names(asset.Alpha_Mode) {fmt.sbprintf(&b,"#define ALPHA_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    strings.write_string(&b,"// asset.Emission_Mode\n")
    for name,i in reflect.enum_field_names(asset.Emission_Mode) {fmt.sbprintf(&b,"#define EMISSION_%s %du\n",strings.to_upper(name,context.temp_allocator),i)}
    strings.write_string(&b,"// asset.Material_Layers: the bit of each layer a material holds besides the base.\n")
    for name,i in reflect.enum_field_names(asset.Material_Layer) {fmt.sbprintf(&b,"#define MATERIAL_LAYER_%s %du\n",strings.to_upper(name,context.temp_allocator),u32(1)<<uint(i))}
    d:=asset.MATERIAL_DEFAULTS
    strings.write_string(&b,"// asset.MATERIAL_DEFAULTS\n")
    color :: proc(b:^strings.Builder,name:string,value:[3]f32) {fmt.sbprintf(b,"#define MATERIAL_DEFAULT_%s float3(%s, %s, %s)\n",name,number(value.x),number(value.y),number(value.z))}
    scalar :: proc(b:^strings.Builder,name:string,value:f32) {fmt.sbprintf(b,"#define MATERIAL_DEFAULT_%s %s\n",name,number(value))}
    color(&b,"BASE_COLOR",d.base_color)
    scalar(&b,"OPACITY",d.opacity)
    scalar(&b,"METALLIC",d.metallic)
    scalar(&b,"ROUGHNESS",d.roughness)
    color(&b,"EMISSION",d.emission)
    color(&b,"SPECULAR_COLOR",d.specular_color)
    scalar(&b,"SPECULAR_FACTOR",d.specular_factor)
    scalar(&b,"IOR",d.ior)
    color(&b,"COAT_COLOR",d.coat.color)
    scalar(&b,"COAT_ROUGHNESS",d.coat.roughness)
    scalar(&b,"COAT_IOR",d.coat.ior)
    color(&b,"FUZZ_COLOR",d.fuzz.color)
    scalar(&b,"FUZZ_ROUGHNESS",d.fuzz.roughness)
    color(&b,"DIFFUSE_TRANSMISSION_COLOR",d.diffuse_transmission.color)
    strings.write_string(&b,"#endif\n")
    return strings.to_string(b)
}

// A float literal of Slang that reads back as the same f32.
@(private)
number :: proc(value:f32) -> string {
    text:=fmt.tprintf("%.9g",value)
    return text if strings.contains_any(text,".e") else strings.concatenate({text,".0"},context.temp_allocator)
}
