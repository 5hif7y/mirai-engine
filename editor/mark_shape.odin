MARK_SHAPE_OUTLINES :: [5][2]u16{{0,9},{9,62},{71,20},{91,35},{126,42}}

// The mark over the square of side 16*s centered at c, its arms in arm and
// its star in star: the triangles, and the outlines as hairlines so the edges
// are smooth at any size.
mark_shape_draw :: proc(ctx:^ui.Context,c:[2]f32,s:f32,arm,star:ui.Color) {
    points:=MARK_SHAPE_POINTS
    triangles:=MARK_SHAPE_TRIANGLES
    for i:=0;i+2<len(triangles);i+=3 {
        color:=star if mark_shape_star(triangles[i]) else arm
        ui.draw_triangle(ctx,c+points[triangles[i]]*s,c+points[triangles[i+1]]*s,c+points[triangles[i+2]]*s,color)
    }
    for outline in MARK_SHAPE_OUTLINES {
        first,count:=int(outline[0]),int(outline[1])
        color:=star if mark_shape_star(outline[0]) else arm
        for k in 0..<count {
            ui.draw_line(ctx,c+points[first+k]*s,c+points[first+(k+1)%count]*s,1,color)
        }
    }
}

// Whether a point belongs to the star: the first outline is the needle under
// the lower arm and the last the star; those between are the arms.
mark_shape_star :: proc(point:u16) -> bool {
    outlines:=MARK_SHAPE_OUTLINES
    return point<outlines[1][0] || point>=outlines[len(outlines)-1][0]
}
