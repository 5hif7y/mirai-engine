#!/usr/bin/env sh
# Compiles the mirai tool when it or the list of its sources is missing, then
# runs it. The tool builds itself again when its sources changed, from that list.
# The way to the tool forks nothing: under Git Bash a fork costs tens of
# milliseconds, and Git Bash hands /c/... paths to native programs as C:/...
set -e
CDPATH=
case "$0" in
    */*) cd -- "${0%/*}"; root="$PWD"; cd -- "$OLDPWD" ;;
    *) root="$PWD" ;;
esac
case "${OS:-}" in
    Windows_NT) windows=1; suffix=.exe ;;
    *) windows=; suffix= ;;
esac
exe="$root/bin/mirai$suffix"
if [ ! -x "$exe" ] || [ ! -f "$exe.sources.json" ]; then
    mkdir -p "$root/bin"
    # MIRAI_ODIN, the Odin of .deps, the one of the main checkout of a worktree, or odin in PATH.
    deps="$root/.deps"
    if [ ! -d "$deps" ]; then
        common="$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        if [ -n "$common" ]; then deps="$(dirname "$common")/.deps"; fi
    fi
    compiler="${MIRAI_ODIN:-}"
    first() { for candidate in "$@"; do if [ -z "$compiler" ] && [ -x "$candidate" ]; then compiler="$candidate"; fi; done; }
    if [ -n "$windows" ]; then
        first "$deps/odin/dist/odin.exe" "$deps/odin/odin.exe"
    else
        first "$deps/linux-amd64/odin/odin" "$deps/odin/dist/odin" "$deps/odin/odin"
        # The tool links C libraries of the Odin root that scripts/setup_linux_deps.py prepares.
        if [ -d "$deps/linux-amd64/odin/vendor" ]; then export ODIN_ROOT="$deps/linux-amd64/odin"; fi
    fi
    # Built apart and then put in place: an executable in use (a mirai mcp that runs) cannot be
    # written on Windows, but it can be renamed, as executable_publish (tools/mirai) does.
    staging="$root/bin/.mirai-build-$$$suffix"
    # The attributes the engine reads in its sources mean nothing to the tool.
    if "${compiler:-odin}" build "$root/tools/mirai" -collection:mirai="$root" -ignore-unknown-attributes -o:minimal -out:"$staging" \
        -export-dependencies:json -export-dependencies-file:"$staging.sources.json" >&2 \
        && { mv -f "$staging" "$exe" 2>/dev/null || { mv "$exe" "$root/bin/.retired-$$$suffix" && mv "$staging" "$exe"; }; }; then
        mv -f "$staging.sources.json" "$exe.sources.json"
    else
        rm -f "$staging" "$staging.sources.json"
        if [ ! -x "$exe" ]; then exit 1; fi
        echo "mirai: could not build or replace the tool; the existing one runs" >&2
    fi
fi
MIRAI_ROOT="$root" exec "$exe" "$@"
