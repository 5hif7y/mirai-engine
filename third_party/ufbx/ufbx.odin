    result_allocator:Allocator_Opts,
    open_file_cb:Open_File_Cb,
    frames_per_second:f64,
    mirror_axis:Mirror_Axis,
    use_scale_factor:bool,
    scale_factor:Real,
    _end_zero:u32,
}

Geometry_Cache_Data_Opts :: struct {
    _begin_zero:u32,
    open_file_cb:Open_File_Cb,
    additive:bool,
    use_weight:bool,
    weight:Real,
    ignore_transform:bool,
    _end_zero:u32,
}

Panic :: struct {
    did_panic:bool,
    message_length:uint,
    message:[128]u8,
}

